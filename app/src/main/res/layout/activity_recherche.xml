<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    tools:context=".RechercheActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/divider_10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:showDividers="middle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stroke"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/ohMyMovies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/meila"
                android:text="@string/oh_my_movies"
                android:textColor="@color/red"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end"
                android:padding="0dp"
                android:text="@string/fr"
                android:textAlignment="viewEnd"
                android:textSize="20sp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_10dp"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/cadreRecherche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stroke"
                    android:divider="@drawable/divider_8dp"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/tv_titreFilm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titre"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_titreFilm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        android:hint="@string/entrez_un_titre_de_film"
                        android:inputType="text"
                        android:textColorHint="@color/gris"
                        tools:ignore="Autofill" />

                    <TextView
                        android:id="@+id/tv_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/genre"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/s_choixGenre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/s_lectionner_un_ou_plusieurs_genres"
                        android:spinnerMode="dropdown" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/genresRecherche"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacing="4dp"></com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/tv_anneeSortie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ann_e_de_sortie"
                        android:textStyle="bold" />

                    <NumberPicker
                        android:id="@+id/np_choixAnneeSortie"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="40dp" />

                    <TextView
                        android:id="@+id/tv_options"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/bt_populaire"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/afficher_uniquement_les_films_populaires"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />

                    <Switch
                        android:id="@+id/bt_tousPublics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/afficher_uniquement_les_films_tous_publics"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />

                    <Button
                        android:id="@+id/bt_recherche"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/red"
                        android:gravity="center"
                        android:text="@string/rechercher"
                        android:textColor="@android:color/white" />

                </LinearLayout>

                <Button
                    android:id="@+id/bt_filmsPopulaires"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/transparent"
                    android:gravity="center"
                    android:text="@string/afficher_les_films_populaires_en_ce_moment"
                    android:textColor="@color/red"
                    app:strokeColor="@color/red"
                    app:strokeWidth="3dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>