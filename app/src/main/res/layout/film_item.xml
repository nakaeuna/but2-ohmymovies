<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/synopsis_stroke"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/posterFilm"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="20dp"
        android:layout_weight="0"
        android:adjustViewBounds="true"
        android:contentDescription="@string/poster_film"
        android:scaleType="centerCrop"
        tools:srcCompat="@tools:sample/avatars" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titreFilm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titre_du_film"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/informationsFilm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/informations_sur_le_film" />

    </LinearLayout>

</LinearLayout>